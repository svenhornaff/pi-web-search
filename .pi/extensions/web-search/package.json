{
  "name": "@svenhornaff/web-search",
  "version": "1.6.0",
  "description": "Web search and content extraction extension for Pi coding agent (Exa, Brave, Tavily)",
  "author": "Brooklyn42",
  "license": "NCSAL",
  "keywords": ["pi-package", "web-search"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "undici": "^8.10.0",
    "js-tiktoken": "^1.0.21",
    "linkedom": "^0.18.12",
    "pdf-parse": "^2.4.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "typecheck":    "cd .. && npm run typecheck",
    "lint":         "cd .. && npm run lint",
    "lint:fix":     "cd .. && npm run lint:fix",
    "test":         "cd .. && npm run test",
    "check:version": "node scripts/check-version.mjs",
    "check":        "npm run check:version && cd .. && npm run check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
